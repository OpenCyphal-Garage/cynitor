        <UserObject label="&lt;div style=&quot;color: rgb(204, 204, 204); background-color: rgb(31, 31, 31); font-family: &amp;quot;Droid Sans Mono&amp;quot;, &amp;quot;monospace&amp;quot;, monospace; font-weight: normal; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;async&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;def&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 170);&quot;&gt;get_registers&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;node_id&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;) -&amp;gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;List&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;Dict&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;[&lt;/span&gt;&lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;str&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;Any&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;]]:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;            &lt;/span&gt;&lt;span style=&quot;color: rgb(156, 220, 254);&quot;&gt;self&lt;/span&gt;&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;